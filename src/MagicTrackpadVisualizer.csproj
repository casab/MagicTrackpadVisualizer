<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TrackpadVisualizer</RootNamespace>
    <AssemblyName>MagicTrackpadVisualizer</AssemblyName>
    <Version>1.0.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The views' shader sources are built into the exe, so the app is a single file.
         They are compiled when it starts. -->
    <None Remove="Shaders\*.hlsl" />
    <EmbeddedResource Include="Shaders\*.hlsl" LogicalName="Shaders/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

</Project>
